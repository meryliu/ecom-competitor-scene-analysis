{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query-policy.schema.json",
  "title": "Query Policy runtime rule",
  "type": "object",
  "required": ["schema_version", "policy_version", "rule_id", "name", "version", "priority", "routing", "applicability", "actions", "source_ref"],
  "properties": {
    "schema_version": {"const": "query_policy_rule/1.0"},
    "policy_version": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "routing": {"type": "object"},
    "applicability": {"type": "object"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "op", "idempotency"],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "op": {"enum": ["preserve", "set_default", "rewrite", "expand_sub_queries", "clarify"]},
          "idempotency": {"const": "application_key"},
          "ir_effect_contract": {
            "type": "object",
            "description": "Optional attribution or scoped-expansion ownership contract; validated by the runtime."
          }
        }
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["heading_path", "block_id"],
      "properties": {
        "heading_path": {"type": "string", "minLength": 1},
        "block_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
