{
  "schema_version": "resolution_policy/2.0",
  "policy_version": "2.6.0",
  "limits": {
    "max_candidates_per_case": 3
  },
  "semantic_normalization": {
    "comparison_terms": {
      "yoy": ["同比"],
      "mom": ["环比"],
      "ytd": ["累计"]
    },
    "measure_terms": {
      "growth_rate": ["增速", "增长率", "涨幅"],
      "share": ["占比", "市占率", "份额"],
      "delta": ["增量", "绝对变化"]
    },
    "core_measure_terms": {
      "count": ["订单量"],
      "price": ["订单价"],
      "gmv": ["gmv"]
    },
    "grain_terms": {
      "day": ["日度"],
      "week": ["周度"],
      "month": ["月度"],
      "quarter": ["季度"],
      "year": ["年度"]
    },
    "scope_terms": {
      "universe": ["大盘", "整体", "全市场"]
    },
    "constraint_operator_terms": {
      "eq": ["仅", "只看", "限定"],
      "in": ["合计", "之和", "包含", "及", "和"],
      "exclude": ["剔除", "不含", "排除", "除去", "去除", "剔", "exclude", "without"]
    },
    "equivalence_rules": [
      {
        "rule_id": "yoy_ratio_abbreviation",
        "comparison_type": "yoy",
        "measure_type": "growth_rate",
        "required_metric_object": "ratio",
        "required_units": ["%", "pp", "rate", "ratio", "share"]
      }
    ]
  },
  "candidate_evaluation": {
    "lexical_recall_floor": 0.78,
    "core_semantic_floor": 0.78,
    "minimum_candidate_margin": 0.1,
    "allow_unique_capability_selection": true
  },
  "grain_rollup": {
    "aggregation_prerequisites": ["metric_additive"],
    "priority": {
      "month": ["month", "week"],
      "quarter": ["quarter", "month", "week"],
      "year": ["year", "quarter", "month", "week"]
    },
    "week_weight_rule": {
      "calendar": "source.period_semantics.week",
      "formula": "overlap_days/7",
      "inclusive_bounds": true
    },
    "allowed_edges": [
      ["day", "week"],
      ["week", "month"],
      ["week", "quarter"],
      ["month", "quarter"],
      ["week", "year"],
      ["month", "year"],
      ["quarter", "year"]
    ]
  },
  "rules": {
    "fact_block_joint_resolution": {
      "hard_gates": [
        "metric_dimension_compatible",
        "source_domain_subset",
        "protected_semantics_compatible"
      ],
      "strong_evidence": [
        "dimension_domain_exact",
        "dimension_name_exact",
        "confirmed_patch"
      ],
      "auto": {
        "require_unique_viable": true,
        "minimum_strong_evidence": 1
      },
      "confirm": {
        "when_viable_candidates_exist": true
      }
    },
    "query_name_resolution": {
      "hard_gates": [
        "metric_object_compatible",
        "unit_compatible",
        "protected_semantics_compatible"
      ],
      "auto": {
        "require_unique_viable": true,
        "minimum_confidence": 0.78,
        "minimum_candidate_margin": 0.1,
        "require_strong_provenance_or_semantics": true
      },
      "confirm": {
        "when_viable_candidates_exist": true
      }
    }
  }
}
