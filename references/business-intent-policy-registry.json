{
  "schema_version": "business_intent_policy/1.0",
  "policy_version": "1.5.0",
  "limits": {
    "max_hypotheses_per_metric": 3,
    "max_candidates_per_case": 3
  },
  "rules": [
    {
      "intent_id": "declared_metric",
      "priority": 100,
      "triggers": {"mode": "always"},
      "metric_term_templates": ["{metric}"],
      "metric_object": "inherit",
      "semantic_role": "primary",
      "allowed_object_provenance": [
        "model_inferred",
        "user_explicit",
        "user_formula",
        "registered_definition",
        "source_metadata"
      ]
    },
    {
      "intent_id": "growth_ratio_metric",
      "priority": 90,
      "triggers": {
        "any": ["同比", "增速", "增长率", "涨幅"]
      },
      "derived_metric_ids": ["yoy_growth", "yoy_trend_change"],
      "metric_term_templates": ["{metric}同比增速", "{metric}增速"],
      "metric_object": "ratio",
      "semantic_role": "primary",
      "skip_if_metric_contains_any": ["同比", "增速", "增长率", "涨幅"],
      "allowed_object_provenance": ["model_inferred"]
    },
    {
      "intent_id": "base_volume_metric",
      "priority": 80,
      "triggers": {
        "any": ["表现", "规模", "金额", "零售额", "销售额", "成交额"]
      },
      "metric_term_templates": ["{metric}"],
      "metric_object": "volume",
      "semantic_role": "primary",
      "skip_if_metric_contains_any": ["同比", "增速", "增长率", "涨幅", "占比", "率"],
      "allowed_object_provenance": ["model_inferred"]
    },
    {
      "intent_id": "performance_growth_alternative",
      "priority": 70,
      "triggers": {
        "any": ["表现", "较好", "较差"]
      },
      "metric_term_templates": ["{metric}同比增速", "{metric}同比", "{metric}增速"],
      "metric_object": "ratio",
      "semantic_role": "compatible_alternative",
      "allowed_object_provenance": ["model_inferred"],
      "skip_if_metric_contains_any": ["同比", "增速", "增长率", "涨幅"]
    }
  ]
}
