{
  "registry_name": "scene-analysis-derived-metrics",
  "registry_version": "1.3.0",
  "definitions": {
    "yoy_growth": {
      "definition_version": "1.2.0",
      "trigger_phrases": ["同比", "年同比", "同期同比", "同比增长"],
      "metric_objects": ["volume", "ratio"],
      "required_period_roles": ["analysis", "analysis_last_year"],
      "expressions": {
        "volume": {
          "op": "subtract",
          "args": [
            {
              "op": "divide",
              "args": [
                {"fact_role": "analysis"},
                {"fact_role": "analysis_last_year"}
              ]
            },
            {"literal": 1}
          ]
        },
        "ratio": {
          "op": "subtract",
          "args": [
            {"fact_role": "analysis"},
            {"fact_role": "analysis_last_year"}
          ]
        }
      },
      "output_units": {"volume": "rate", "ratio": "pp"},
      "minimal_validation": ["facts_present", "unit_consistent", "required_denominator_nonzero"]
    },
